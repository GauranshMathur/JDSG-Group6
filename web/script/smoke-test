#!/usr/bin/env bash
#
# End-to-end smoke test against a running instance, over real HTTP.
#
# The same script runs locally and in CI, so a failure here can always be
# reproduced without pushing:
#
#   script/smoke-test                       # against http://localhost:3000
#   script/smoke-test http://localhost:3100 # against somewhere else
#
# This exists because the request specs cannot catch everything the real stack
# does. Milestone 1 shipped a bug where every POST returned 422 — the specs
# passed, because `assume_ssl` only misbehaves over real HTTP with a real
# Origin header. Anything asserted here is asserted against the actual server.
set -euo pipefail

BASE="${1:-http://localhost:3000}"
MARKER="smoke-$(date +%s)-$RANDOM"
EMAIL="smoke-$(date +%s)-$RANDOM@example.com"
# Letters, digits and underscores only, and at most 20 characters — the
# username rules are stricter than the email's.
USERNAME="s$(date +%s)$RANDOM"
PASSWORD="smoke-test-password"
COOKIES="$(mktemp)"
trap 'rm -f "$COOKIES"' EXIT

fail() {
  echo "FAIL: $1"
  [ $# -gt 1 ] && head -c 2000 "$2"
  exit 1
}

pass() { echo "PASS: $1"; }

# Reads the page-wide CSRF token from the <meta> tag, which is what Turbo and
# rails-ujs use and which Rails accepts for any action.
#
# Deliberately NOT the first authenticity_token input on the page: Rails issues
# per-form tokens scoped to the form's action and method, and since the masthead
# arrived the first form on the feed is sign-out, whose token is only valid for
# DELETE /session. Scraping that and posting it to /posts gets a 422.
token_from() {
  grep -oE '<meta name="csrf-token" content="[^"]+"' "$1" \
    | head -1 | sed 's/.*content="//; s/"$//'
}

echo "Smoke testing $BASE"

# --- Reading is public (F-2.5) ------------------------------------------------

curl -sS "$BASE/" -o /tmp/smoke-feed-anon
grep -q "Feed" /tmp/smoke-feed-anon || fail "the feed did not render for a signed-out visitor" /tmp/smoke-feed-anon
pass "signed-out visitor can read the feed"

grep -q "to post." /tmp/smoke-feed-anon || fail "signed-out visitor was not shown a sign-in prompt" /tmp/smoke-feed-anon
pass "signed-out visitor sees a sign-in prompt instead of the composer"

# --- Writing is guarded (F-2.6) -----------------------------------------------

anon_status=$(curl -sS -o /dev/null -w '%{http_code}' \
  -X POST "$BASE/posts" \
  --data-urlencode "post[body]=should-not-exist-$MARKER")
[ "$anon_status" = "200" ] && fail "a signed-out POST /posts returned 200; writing is not guarded"
pass "signed-out posting refused with HTTP $anon_status"

# --- Registration (F-2.1) -----------------------------------------------------

curl -sS -c "$COOKIES" "$BASE/registration/new" -o /tmp/smoke-signup
signup_token=$(token_from /tmp/smoke-signup)
[ -z "$signup_token" ] && fail "no CSRF token on the sign-up page" /tmp/smoke-signup

reg_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-register \
  -w '%{http_code}' -X POST "$BASE/registration" \
  --data-urlencode "authenticity_token=$signup_token" \
  --data-urlencode "user[username]=$USERNAME" \
  --data-urlencode "user[email_address]=$EMAIL" \
  --data-urlencode "user[password]=$PASSWORD" \
  --data-urlencode "user[password_confirmation]=$PASSWORD")
[ "$reg_status" != "302" ] && fail "registering returned HTTP $reg_status, expected 302" /tmp/smoke-register
pass "registered an account"

# The sidebar shows the signed-in account's handle — the email address is
# deliberately nowhere on the page.
curl -sS -b "$COOKIES" -c "$COOKIES" "$BASE/" -o /tmp/smoke-feed
grep -q "@$USERNAME" /tmp/smoke-feed || fail "the feed does not show the new account as signed in" /tmp/smoke-feed
pass "registration signed the account in"

# --- Posting while signed in --------------------------------------------------

token=$(token_from /tmp/smoke-feed)
[ -z "$token" ] && fail "no CSRF token on the feed page while signed in" /tmp/smoke-feed

status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-post \
  -w '%{http_code}' -X POST "$BASE/posts" \
  -H 'Accept: text/vnd.turbo-stream.html' \
  --data-urlencode "authenticity_token=$token" \
  --data-urlencode "post[body]=$MARKER")
[ "$status" != "200" ] && fail "creating a post returned HTTP $status, expected 200" /tmp/smoke-post

grep -q 'turbo-stream action="prepend"' /tmp/smoke-post \
  || fail "the response was not a turbo stream that prepends the post" /tmp/smoke-post
pass "signed-in user posted, and got a turbo stream back"

# Read back signed out on the author's profile — the ranked feed may not show a
# brand-new zero-engagement post on page 1, but the profile page always does.
curl -sS "$BASE/@$USERNAME" | grep -q "$MARKER" \
  || fail "the new post is not on the profile after posting it"
pass "the post survives a round trip and is visible to everyone"

# --- Posting an image (F-7.2, F-7.3) -------------------------------------------
#
# Fetching the resized variant is the only request in the stack that exercises
# libvips. The production image once shipped without it: the app booted, served
# every page, and passed every check above while unable to process a single
# image. So this uploads a real PNG and demands the processed variant back.

IMAGE_FILE="$(mktemp)"
trap 'rm -f "$COOKIES" "$IMAGE_FILE"' EXIT
base64 -d > "$IMAGE_FILE" <<'PNG'
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==
PNG

img_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-image-post \
  -w '%{http_code}' -X POST "$BASE/posts" \
  -H 'Accept: text/vnd.turbo-stream.html' \
  -F "authenticity_token=$token" \
  -F "post[body]=$MARKER with image" \
  -F "post[images][]=@$IMAGE_FILE;type=image/png;filename=smoke.png")
[ "$img_status" != "200" ] && fail "posting with an image returned HTTP $img_status, expected 200" /tmp/smoke-image-post

variant_url=$(grep -oE '(src|href)="[^"]*/rails/active_storage/representations/[^"]*"' /tmp/smoke-image-post \
  | head -1 | sed 's/^[a-z]*="//; s/"$//')
[ -z "$variant_url" ] && fail "the response to posting an image contains no variant URL" /tmp/smoke-image-post

# The URL may be a path or absolute depending on the helper; handle both.
case "$variant_url" in
  http*) : ;;
  *) variant_url="$BASE$variant_url" ;;
esac

variant_status=$(curl -sSL -o /tmp/smoke-variant -w '%{http_code}' "$variant_url")
[ "$variant_status" != "200" ] \
  && fail "fetching the image variant returned HTTP $variant_status — is libvips installed?" /tmp/smoke-variant
pass "an uploaded image comes back as a processed variant"

# --- Profiles (F-4.3, F-2.5) --------------------------------------------------

# No cookies on purpose: profiles are public.
curl -sS "$BASE/@$USERNAME" -o /tmp/smoke-profile
grep -q "$MARKER" /tmp/smoke-profile \
  || fail "the profile page does not list the account's post" /tmp/smoke-profile
pass "the profile page is public and lists the account's posts"

missing_status=$(curl -sS -o /dev/null -w '%{http_code}' "$BASE/@nobody_smoke_$RANDOM")
[ "$missing_status" != "404" ] && fail "a profile nobody holds returned HTTP $missing_status, expected 404"
pass "an unknown profile 404s"

# --- Editing your own profile (F-4.4) -----------------------------------------

curl -sS -b "$COOKIES" -c "$COOKIES" "$BASE/profile/edit" -o /tmp/smoke-profile-edit
profile_token=$(token_from /tmp/smoke-profile-edit)
[ -z "$profile_token" ] && fail "no CSRF token on the profile edit page" /tmp/smoke-profile-edit

DISPLAY_NAME="Smoke Tester $RANDOM"
profile_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-profile-update \
  -w '%{http_code}' -X POST "$BASE/profile" \
  -H 'Accept: text/html' \
  --data-urlencode "authenticity_token=$profile_token" \
  --data-urlencode "_method=patch" \
  --data-urlencode "user[display_name]=$DISPLAY_NAME" \
  --data-urlencode "user[bio]=Set by the smoke test.")
[ "$profile_status" != "302" ] && fail "updating the profile returned HTTP $profile_status, expected 302" /tmp/smoke-profile-update

curl -sS "$BASE/@$USERNAME" -o /tmp/smoke-profile-after
grep -q "$DISPLAY_NAME" /tmp/smoke-profile-after \
  || fail "the display name is not on the profile after saving it" /tmp/smoke-profile-after
grep -q "Set by the smoke test." /tmp/smoke-profile-after \
  || fail "the bio is not on the profile after saving it" /tmp/smoke-profile-after
pass "display name and bio can be edited and are publicly visible"

# --- Renaming, and uniqueness (F-4.6, ADR 0007) -------------------------------

# A second account, only so there is a username already held to collide with.
OTHER_COOKIES="$(mktemp)"
trap 'rm -f "$COOKIES" "$OTHER_COOKIES"' EXIT
OTHER_USERNAME="o$(date +%s)$RANDOM"

curl -sS -c "$OTHER_COOKIES" "$BASE/registration/new" -o /tmp/smoke-other-signup
other_token=$(token_from /tmp/smoke-other-signup)
other_status=$(curl -sS -b "$OTHER_COOKIES" -c "$OTHER_COOKIES" -o /tmp/smoke-other-register \
  -w '%{http_code}' -X POST "$BASE/registration" \
  --data-urlencode "authenticity_token=$other_token" \
  --data-urlencode "user[username]=$OTHER_USERNAME" \
  --data-urlencode "user[email_address]=other-$EMAIL" \
  --data-urlencode "user[password]=$PASSWORD" \
  --data-urlencode "user[password_confirmation]=$PASSWORD")
[ "$other_status" != "302" ] && fail "registering the second account returned HTTP $other_status" /tmp/smoke-other-register

# Renaming onto a name someone already holds is refused, and says so.
curl -sS -b "$COOKIES" -c "$COOKIES" "$BASE/profile/edit" -o /tmp/smoke-rename-edit
rename_token=$(token_from /tmp/smoke-rename-edit)
grep -q 'name="user\[username\]"' /tmp/smoke-rename-edit \
  || fail "the profile edit form has no username field" /tmp/smoke-rename-edit

taken_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-rename-taken \
  -w '%{http_code}' -X POST "$BASE/profile" \
  -H 'Accept: text/html' \
  --data-urlencode "authenticity_token=$rename_token" \
  --data-urlencode "_method=patch" \
  --data-urlencode "user[username]=$OTHER_USERNAME")
[ "$taken_status" != "422" ] \
  && fail "renaming onto a taken username returned HTTP $taken_status, expected 422" /tmp/smoke-rename-taken
grep -q "has already been taken" /tmp/smoke-rename-taken \
  || fail "renaming onto a taken username did not say it was taken" /tmp/smoke-rename-taken
pass "a username already held is refused with 'has already been taken'"

# A free name is accepted, and the profile moves to the new handle.
OLD_USERNAME="$USERNAME"
NEW_USERNAME="r$(date +%s)$RANDOM"
rename_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-rename \
  -w '%{http_code}' -X POST "$BASE/profile" \
  -H 'Accept: text/html' \
  --data-urlencode "authenticity_token=$rename_token" \
  --data-urlencode "_method=patch" \
  --data-urlencode "user[username]=$NEW_USERNAME")
[ "$rename_status" != "302" ] && fail "renaming returned HTTP $rename_status, expected 302" /tmp/smoke-rename

new_status=$(curl -sS -o /tmp/smoke-renamed -w '%{http_code}' "$BASE/@$NEW_USERNAME")
[ "$new_status" != "200" ] && fail "the profile at the new username returned HTTP $new_status" /tmp/smoke-renamed
grep -q "$MARKER" /tmp/smoke-renamed \
  || fail "the renamed profile does not list the account's post" /tmp/smoke-renamed

# ADR 0007 accepts this: there is no redirect table, so the old handle is gone.
old_status=$(curl -sS -o /dev/null -w '%{http_code}' "$BASE/@$OLD_USERNAME")
[ "$old_status" != "404" ] \
  && fail "the old username returned HTTP $old_status, expected 404 (no redirect table — ADR 0007)"
pass "a username can be changed; the new handle serves the profile and the old one 404s"

# Everything after this point addresses the account by its current handle.
USERNAME="$NEW_USERNAME"

# --- Editing and deleting your own post (F-3.2, F-3.3) ------------------------

post_id=$(grep -oE 'id="post_[0-9]+"' /tmp/smoke-post | head -1 | grep -oE '[0-9]+')
[ -z "$post_id" ] && fail "could not find the new post's id in the turbo stream" /tmp/smoke-post

curl -sS -b "$COOKIES" -c "$COOKIES" "$BASE/posts/$post_id/edit" -o /tmp/smoke-edit
grep -q "$MARKER" /tmp/smoke-edit || fail "the edit form does not contain the post" /tmp/smoke-edit
pass "the author can open their own post for editing"

edit_token=$(token_from /tmp/smoke-edit)
edited="$MARKER-edited"
edit_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /tmp/smoke-update \
  -w '%{http_code}' -X POST "$BASE/posts/$post_id" \
  -H 'Accept: text/html' \
  --data-urlencode "authenticity_token=$edit_token" \
  --data-urlencode "_method=patch" \
  --data-urlencode "post[body]=$edited")
[ "$edit_status" != "302" ] && fail "editing returned HTTP $edit_status, expected 302" /tmp/smoke-update

curl -sS "$BASE/@$USERNAME" | grep -q "$edited" || fail "the edited body is not on the profile"
pass "the edit is saved and visible to everyone"

del_status=$(curl -sS -b "$COOKIES" -c "$COOKIES" -o /dev/null \
  -w '%{http_code}' -X POST "$BASE/posts/$post_id" \
  -H 'Accept: text/html' \
  --data-urlencode "authenticity_token=$edit_token" \
  --data-urlencode "_method=delete")
[ "$del_status" != "302" ] && fail "deleting returned HTTP $del_status, expected 302"

curl -sS "$BASE/@$USERNAME" | grep -q "$edited" && fail "the deleted post is still on the profile"
pass "the author can delete their own post"

# --- Sign out revokes the session (F-2.4) -------------------------------------

signout_token=$(token_from /tmp/smoke-feed)
curl -sS -b "$COOKIES" -c "$COOKIES" -o /dev/null \
  -X POST "$BASE/session" \
  --data-urlencode "authenticity_token=$signout_token" \
  --data-urlencode "_method=delete"

curl -sS -b "$COOKIES" "$BASE/" -o /tmp/smoke-feed-after
grep -q "to post." /tmp/smoke-feed-after \
  || fail "still signed in after signing out" /tmp/smoke-feed-after
pass "signing out returns the visitor to the signed-out feed"

echo
echo "All smoke checks passed against $BASE"
