<% content_for :title, "Reset password" %>

<div class="auth">
  <h1 class="auth__heading">Forgot your password?</h1>

  <p class="auth__hint">
    Reset instructions are written to the development mail log rather than sent —
    nothing delivers email in this proof of concept. See N-5.1 in REQUIREMENTS.md.
  </p>

  <%= form_with url: passwords_path, class: "auth__form" do |form| %>
    <%= form.label :email_address, "Email address", class: "auth__label" %>
    <%= form.email_field :email_address,
          class: "auth__input",
          required: true,
          autofocus: true,
          autocomplete: "username",
          value: params[:email_address] %>

    <%= form.submit "Email reset instructions", class: "auth__submit" %>
  <% end %>

  <p class="auth__alternative">
    <%= link_to "Back to sign in", new_session_path %>
  </p>
</div>
