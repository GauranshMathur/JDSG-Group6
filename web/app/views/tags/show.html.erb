<% content_for :title, "##{@tag.name}" %>

<div class="feed">
  <h1 class="feed__heading">#<%= @tag.name %></h1>

  <div id="timeline" class="timeline">
    <%= render partial: "posts/post", collection: @posts,
              locals: { liked_post_ids: @liked_post_ids, reposted_post_ids: @reposted_post_ids } %>

    <% if @posts.empty? %>
      <p class="timeline__empty">No posts with this tag yet.</p>
    <% end %>
  </div>

  <%= render "posts/pagination",
        next_cursor: @next_cursor,
        url: tag_path(@tag.name, after: @next_cursor) %>
</div>
