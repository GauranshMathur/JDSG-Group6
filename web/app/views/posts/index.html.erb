<% content_for :title, "Feed" %>

<div class="feed">
  <h1 class="feed__heading">Feed</h1>

  <%# Reading is public, so signed-out visitors get the timeline and a prompt
      rather than a form that would only bounce them to sign in. %>
  <% if authenticated? %>
    <%= render "posts/composer", post: @post %>
  <% else %>
    <%= render "posts/sign_in_prompt" %>
  <% end %>

  <div id="timeline" class="timeline">
    <%= render partial: "posts/post", collection: @posts,
              locals: { liked_post_ids: @liked_post_ids } %>

    <% if @posts.empty? %>
      <p id="timeline_empty" class="timeline__empty">Nothing here yet. Be the first to post.</p>
    <% end %>
  </div>

  <%= render "posts/pagination", next_cursor: @next_cursor, url: posts_path(after: @next_cursor) %>
</div>
