<%# Renders a user's avatar, or the default silhouette when none is uploaded.
    size: :thumbnail (48px) or :display (128px) %>
<% size ||= :thumbnail %>
<% if user.avatar.attached? %>
  <%= image_tag(size == :thumbnail ? user.avatar_thumbnail : user.avatar_display,
        class: "avatar avatar--#{size}",
        alt: "#{user.name}'s avatar") %>
<% else %>
  <%= image_tag "default-avatar.svg", class: "avatar avatar--#{size}", alt: "" %>
<% end %>
