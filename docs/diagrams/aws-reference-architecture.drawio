        <mxCell id="drnote" value="Pilot light: no compute runs here. Recovery = Terraform apply into this region, restore RDS from the copied snapshots, point Active Storage at the replica bucket, and Route 53 health-check failover flips DNS. RTO is the apply + restore time; RPO is the snapshot/replication lag." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1800" y="480" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="drnote2" value="Local realization: demonstrated on paper and, at most, as a second floci endpoint — region-level DR is the one layer of the reference that stays reference-only." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#00A4A6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1800" y="620" width="480" height="80" as="geometry" />
